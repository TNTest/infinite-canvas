{
    "mcpServers": {
        "infinite-canvas": {
            "command": "npx",
            "args": ["--yes", "--ignore-scripts", "--install-links", "--package=.", "canvas-agent", "mcp"],
            "cwd": ".",
            "env_vars": ["CANVAS_API_URL", "CANVAS_API_KEY", "CANVAS_API_PROJECT"],
            "startup_timeout_sec": 180,
            "tool_timeout_sec": 300
        }
    }
}
